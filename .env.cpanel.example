APP_NAME=SAPTARA
APP_ENV=production
APP_KEY=base64:saptaraPRODkey7KebiasaanHebat2026SecureKey=
APP_DEBUG=false
APP_URL=https://domainanda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ================================================================
# KONFIGURASI DATABASE MYSQL (cPanel)
# 1. Buka cPanel -> MySQL Databases
# 2. Buat database baru (misal: cpaneluser_saptara)
# 3. Buat user database baru dan berikan ALL PRIVILEGES ke database
# 4. Buka phpMyAdmin -> pilih database -> Import file database/saptara_production.sql
# ================================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_saptara
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=PasswordDatabaseAnda

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ================================================================
# KONFIGURASI PENGIRIMAN EMAIL (Opsional - SMTP cPanel)
# ================================================================
MAIL_MAILER=log
# Ubah ke smtp jika ingin mengirim email nyata:
# MAIL_MAILER=smtp
# MAIL_HOST=mail.domainanda.com
# MAIL_PORT=465
