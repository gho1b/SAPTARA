[Unit]
Description=SAPTARA Server - Backend API (Node.js/Express)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/app/server
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=saptara-server

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATABASE_PATH=./saptara.db
Environment=BETTER_AUTH_SECRET=saptara-secret-key-change-in-production
Environment=BETTER_AUTH_URL=https://d7ad3476-f9f6-433e-8580-bfcd2ac5ba64.svc.dalang.io
Environment=JWT_SECRET=saptara-student-jwt-secret-change-in-production
Environment=UPLOAD_DIR=./uploads

[Install]
WantedBy=multi-user.target
