[Unit]
Description=SAPTARA Client - Frontend (Vite Preview)
After=network.target saptara-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/app/client
ExecStart=/usr/bin/npx vite preview --host 0.0.0.0 --port 4173
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=saptara-client

# Environment
Environment=NODE_ENV=production
Environment=VITE_API_BASE=https://d7ad3476-f9f6-433e-8580-bfcd2ac5ba64.svc.dalang.io/api

[Install]
WantedBy=multi-user.target
